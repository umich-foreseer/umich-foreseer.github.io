{% assign compact_description = project.description
  | replace: '<br>', ' · '
  | replace: '<br/>', ' · '
  | replace: '<br />', ' · '
  | strip_html
  | strip
%}
<li class="people-compact-item">
  <a class="people-compact-link" href="{% if project.redirect %}{{ project.redirect }}{% else %}{{ project.url | relative_url }}{% endif %}">
    <span class="people-compact-name">{{ project.title }}</span>
    <span class="people-compact-description">{{ compact_description }}</span>
  </a>
</li>
